{
  "name": "warmachine-analyzer-backend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "lint-staged": {
    "*.ts": "eslint --max-warnings 0 --fix"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:prod": "node dist/main",
    "crawl": "ts-node -r tsconfig-paths/register src/crawl.ts",
    "prune": "ts-node -r tsconfig-paths/register src/prune.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --max-warnings 0 --fix",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "typeorm:generate-migrations": "npm run typeorm migration:generate -- -d ./src/domain/database/data-source.ts",
    "openapi": "node ../scripts/export-openapi.mjs http://localhost:3000/api-json openapi.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "domhandler": "^5.0.3",
    "dotenv": "^18.0.10",
    "joi": "^18.3.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
