DB_URL=postgres://admin:secret@localhost:5010/analyzer?sslmode=disable

LONGSHANKS_BASEURL=https://warmachine.longshanks.org
LONGSHANKS_REQUEST_DELAY_MS=1000
LONGSHANKS_MAX_CONCURRENT_REQUESTS=2

# The official army indexes from the Warmachine Academy wiki, used to match list entries to models.
WIKI_BASEURL=https://warmachineacademy.miraheze.org
WIKI_REQUEST_DELAY_MS=500

# How many events the crawler imports at once. All share the request limits above.
CRAWLER_EVENT_CONCURRENCY=2

# Optional: crawl new events while the backend runs, e.g. every day at 04:00.
CRAWLER_SCHEDULE=
CRAWLER_LOOKBACK_DAYS=14
